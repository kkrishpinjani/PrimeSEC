# Copy this file to .env. Replace every password/secret before non-local use.
# The local Keycloak realm import expects KEYCLOAK_CLIENT_SECRET to match this value.
NEXTAUTH_URL=http://localhost:3010
NEXTAUTH_SECRET=replace-with-a-long-random-secret-generated-by-setup-script
KEYCLOAK_ISSUER=http://localhost:8080/realms/primesoc
KEYCLOAK_CLIENT_ID=primesoc-web
KEYCLOAK_CLIENT_SECRET=primesoc-local-dev-secret-change-me
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=replace-this-local-admin-password

# Optional: link to your existing Wazuh dashboard. Keep blank until known.
WAZUH_DASHBOARD_URL=

# Local-only passwordless "Try the demo" button on /login. Bypasses Keycloak; ignored in production builds.
DEMO_LOGIN=false
# Fallback role if a demo sign-in does not name one (the login page has Admin / Analyst / Read-only buttons).
DEMO_LOGIN_ROLE=SOC_ReadOnly

# ---- Day 2: live integrations (all server-side; never sent to the browser) ----
# Wazuh Manager API: agent status. Use a least-privilege, read-only account.
WAZUH_API_URL=
WAZUH_API_USERNAME=
WAZUH_API_PASSWORD=
# Wazuh Indexer/OpenSearch: optional, enables alert counts and recent alerts (separate service and credentials).
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=
WAZUH_ALERT_INDEX_PATTERN=wazuh-alerts-4.x-*
# OpenCTI: read-only API token for indicators, reports and threat actors.
OPENCTI_URL=
OPENCTI_API_TOKEN=
# Upstream timeout in milliseconds.
INTEGRATION_TIMEOUT_MS=10000

# ---- Dashboard labels and map (all optional; chips/paths are hidden when unset) ----
PRIMESEC_TEAM=
PRIMESEC_REGION=
# Where your SOC is: attack paths on the globe end here. Decimal degrees.
PRIMESEC_HOME_LAT=
PRIMESEC_HOME_LON=
PRIMESEC_HOME_LABEL=SOC
# Wazuh Vulnerability Detector index (Wazuh 4.8+).
WAZUH_VULN_INDEX_PATTERN=wazuh-states-vulnerabilities-*

# Set to true ONLY when the URLs above point at `npm run demo:integrations` (fake data): the UI then says "Demo data".
DEMO_INTEGRATIONS=false

# ---- Day 4: Greenbone / OpenVAS (VAPT) ----
# The bridge (./bridge) runs next to Greenbone. Keep it on loopback or a private network.
GREENBONE_BRIDGE_URL=
# Must equal GREENBONE_BRIDGE_TOKEN in bridge/.env (at least 32 random characters).
GREENBONE_BRIDGE_TOKEN=
GREENBONE_TIMEOUT_MS=15000
# Starting a scan runs three sequential gvm-cli commands, so it gets a much longer timeout than reads.
GREENBONE_LAUNCH_TIMEOUT_MS=120000
# Importing findings reads every result of the recent reports, which can be slow.
GREENBONE_SYNC_TIMEOUT_MS=60000

