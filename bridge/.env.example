# Configure on the Linux host that can access the Greenbone gvmd Unix socket.
GREENBONE_BRIDGE_HOST=127.0.0.1
GREENBONE_BRIDGE_PORT=8787
# At least 32 random characters, e.g. `openssl rand -base64 48`. Must equal GREENBONE_BRIDGE_TOKEN in PrimeSEC's .env.
GREENBONE_BRIDGE_TOKEN=replace-with-at-least-32-random-characters
GREENBONE_GMP_SOCKET=/run/gvmd/gvmd.sock

# Preferred: a gvm-tools config file (chmod 600) containing
#   [gmp]
#   username=primesec
#   password=...
# This keeps the password out of the process list.
GVM_CLI_CONFIG=
# Fallback only (the password is then visible in `ps` to other local users):
GREENBONE_GMP_USERNAME=
GREENBONE_GMP_PASSWORD=

GVM_CLI_PATH=gvm-cli
GREENBONE_SCAN_CONFIG_ID=daba56c8-73ec-11df-a475-002264764cea
GREENBONE_PORT_LIST_ID=33d0cd82-57c6-11e1-8ed1-406186ea4fc5
GREENBONE_SCANNER_ID=08b69003-5fc2-4037-a479-93b440211c73
GREENBONE_COMMAND_TIMEOUT=45

# Optional second allow-list, owned by whoever runs Greenbone, independent of PrimeSEC's approved scopes.
# Comma-separated CIDRs the bridge will ever scan, e.g. 10.20.0.0/16,192.168.50.0/24. Empty = not restricted.
GREENBONE_ALLOWED_RANGES=
