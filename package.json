{
  "name": "primesec",
  "version": "1.0.0",
  "private": true,
  "description": "PrimeSEC: security operations workspace over Wazuh, OpenCTI and Greenbone, with Keycloak SSO, governed investigations and authorized VAPT scans",
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "lint": "next lint",
    "demo:integrations": "node scripts/demo-integrations.js",
    "test:vapt": "node --experimental-strip-types --no-warnings scripts/test-vapt-scope.mjs",
    "typecheck": "tsc --noEmit",
    "test:lib": "node --experimental-strip-types --no-warnings scripts/test-lib.mjs",
    "test": "npm run test:vapt && npm run test:lib && npm run test:findings && npm run test:risk && npm run test:reports && npm run test:demodata && npm run test:cyberreasoner && npm run test:telemetry && npm run test:agentsec && npm run test:agentgate && npm run test:sap && npm run test:inventory && npm run test:sync && npm run test:response && npm run test:response-adapter && npm run test:graph && npm run test:cases && npm run test:wazuh && npm run test:opencti && npm run test:investigate && npm run test:bridge && npm run test:scheduler",
    "test:findings": "node --experimental-strip-types --no-warnings scripts/test-findings.mjs",
    "test:risk": "node --experimental-strip-types --no-warnings scripts/test-risk.mjs",
    "test:demodata": "node --experimental-strip-types --no-warnings scripts/test-demodata.mjs",
    "test:cyberreasoner": "node --experimental-strip-types --no-warnings scripts/test-cyberreasoner.mjs",
    "test:telemetry": "node --experimental-strip-types --no-warnings scripts/test-telemetry.mjs",
    "test:agentsec": "node --experimental-strip-types --no-warnings scripts/test-agentsec.mjs",
    "test:agentgate": "node --experimental-strip-types --no-warnings scripts/test-agentgate.mjs",
    "test:inventory": "node --experimental-strip-types --no-warnings scripts/test-inventory.mjs",
    "test:sync": "node --experimental-strip-types --no-warnings scripts/test-sync.mjs",
    "test:response": "node --experimental-strip-types --no-warnings scripts/test-response.mjs",
    "test:response-adapter": "node --experimental-strip-types --no-warnings scripts/test-response-adapter.mjs",
    "test:graph": "node --experimental-strip-types --no-warnings scripts/test-graph.mjs",
    "test:cases": "node --experimental-strip-types --no-warnings scripts/test-cases.mjs",
    "test:wazuh": "node --experimental-strip-types --no-warnings scripts/test-wazuh.mjs",
    "test:opencti": "node --experimental-strip-types --no-warnings scripts/test-opencti.mjs",
    "test:investigate": "node --experimental-strip-types --no-warnings scripts/test-investigate.mjs",
    "test:bridge": "python -I scripts/test_bridge_platform.py",
    "test:scheduler": "node --experimental-strip-types --no-warnings scripts/test-scheduler.mjs",
    "test:sap": "node --experimental-strip-types --no-warnings scripts/test-sap.mjs",
    "test:reports": "node --experimental-strip-types --no-warnings scripts/test-reports.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-metrics": "2.9.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "@opentelemetry/semantic-conventions": "1.38.0",
    "framer-motion": "11.18.2",
    "next": "15.5.28",
    "next-auth": "4.24.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/three": "0.170.0",
    "@types/topojson-client": "3.1.5",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "typescript": "5.7.2"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.31"
    }
  }
